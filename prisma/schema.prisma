generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  INVENTORY_CLERK
}

enum SaleStatus {
  OPEN
  COMPLETED
  VOIDED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

enum InventoryMovementType {
  SALE
  SALE_VOID
  REFUND
  PURCHASE_RECEIVED
  DAMAGE
  EXPIRED
  THEFT
  MANUAL_ADJUSTMENT
}

enum ShiftStatus {
  OPEN
  CLOSED
  FORCE_CLOSED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}


model Business {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  users              User[]
  stores             Store[]
  categories         Category[]
  products           Product[]
  inventory          Inventory[]
  sales              Sale[]
  refunds            Refund[]
  shifts             Shift[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  inventoryMovements InventoryMovement[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("businesses")
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String              @map("password_hash")
  role               UserRole            @default(CASHIER)
  active             Boolean             @default(true)
  businessId         String              @map("business_id")
  business           Business            @relation(fields: [businessId], references: [id])
  storeAssignments   UserStore[]
  sales              Sale[]              @relation("CashierSales")
  voidedSales        Sale[]              @relation("VoidedBy")
  createdRefunds     Refund[]            @relation("RefundCreator")
  shifts             Shift[]             @relation("CashierShifts")
  forceClosedShifts       Shift[]             @relation("ShiftForceCloser")
  createdPurchaseOrders     PurchaseOrder[]     @relation("PurchaseOrderCreator")
  orderedPurchaseOrders     PurchaseOrder[]     @relation("PurchaseOrderOrderer")
  cancelledPurchaseOrders   PurchaseOrder[]     @relation("PurchaseOrderCanceller")
  inventoryMovements        InventoryMovement[] @relation("MovementCreator")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("users")
}


model Store {
  id          String      @id @default(cuid())
  businessId  String      @map("business_id")
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  code        String
  address     String?
  phone       String?
  active      Boolean     @default(true)
  userAccess      UserStore[]
  inventory       Inventory[]
  sales           Sale[]
  refunds         Refund[]
  shifts          Shift[]
  purchaseOrders  PurchaseOrder[]
  movements       InventoryMovement[]
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([name])
  @@unique([businessId, code])
  @@map("stores")
}

model UserStore {
  userId     String   @map("user_id")
  storeId    String   @map("store_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, storeId])
  @@index([storeId])
  @@map("user_stores")
}

model Category {
  id        String    @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  name      String
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([businessId])
  @@unique([businessId, name])
  @@map("categories")
}

model Product {
  id             String              @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  barcode        String
  sku            String
  name           String
  brand          String?
  categoryId     String              @map("category_id")
  category       Category            @relation(fields: [categoryId], references: [id])
  costPrice      Decimal             @db.Decimal(10, 2) @map("cost_price")
  sellingPrice   Decimal             @db.Decimal(10, 2) @map("selling_price")
  minimumStock   Int                 @default(5) @map("minimum_stock")
  taxable        Boolean             @default(true)
  active         Boolean             @default(true)
  inventories    Inventory[]
  saleItems          SaleItem[]
  purchaseOrderItems PurchaseOrderItem[]
  movements          InventoryMovement[]
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([name])
  @@index([categoryId])
  @@index([businessId])
  @@unique([businessId, barcode])
  @@unique([businessId, sku])
  @@map("products")
}

model Inventory {
  id        String   @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  storeId    String   @map("store_id")
  store      Store @relation(fields: [storeId], references: [id])
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([businessId])
  @@index([productId])
  @@index([storeId])
  @@unique([storeId, productId])
  @@map("inventory")
}

model Sale {
  id            String        @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  storeId    String   @map("store_id")
  store      Store @relation(fields: [storeId], references: [id])
  receiptNumber String        @map("receipt_number")
  cashierId     String        @map("cashier_id")
  cashier       User          @relation("CashierSales", fields: [cashierId], references: [id])
  cashierName   String?       @map("cashier_name")
  status        SaleStatus    @default(OPEN)
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  shiftId       String?       @map("shift_id")
  shift         Shift?        @relation(fields: [shiftId], references: [id])
  items         SaleItem[]
  refunds       Refund[]
  movements     InventoryMovement[]
  createdAt     DateTime      @default(now()) @map("created_at")
  completedAt   DateTime?     @map("completed_at")
  voidedAt      DateTime?     @map("voided_at")
  voidReason    String?       @map("void_reason")
  voidedById    String?       @map("voided_by_id")
  voidedBy      User?         @relation("VoidedBy", fields: [voidedById], references: [id])

  @@index([createdAt])
  @@index([cashierId])
  @@index([shiftId])
  @@index([businessId])
  @@unique([businessId, receiptNumber])
  @@index([storeId])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String  @map("sale_id")
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  productName    String? @map("product_name")
  productBarcode String? @map("product_barcode")
  productSku     String? @map("product_sku")
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2) @map("unit_price")
  unitCost  Decimal @db.Decimal(10, 2) @map("unit_cost")
  tax       Decimal @default(0) @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2) @map("line_total")
  refundItems RefundItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}


model Refund {
  id            String       @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  storeId    String   @map("store_id")
  store      Store @relation(fields: [storeId], references: [id])
  refundNumber  String       @map("refund_number")
  saleId        String       @map("sale_id")
  sale          Sale         @relation(fields: [saleId], references: [id])
  amount        Decimal      @db.Decimal(10, 2)
  reason        String
  createdById   String       @map("created_by_id")
  createdBy     User         @relation("RefundCreator", fields: [createdById], references: [id])
  items         RefundItem[]
  movements     InventoryMovement[]
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([saleId, createdAt])
  @@index([createdById])
  @@index([businessId])
  @@unique([businessId, refundNumber])
  @@index([storeId])
  @@map("refunds")
}

model RefundItem {
  id          String   @id @default(cuid())
  refundId    String   @map("refund_id")
  refund      Refund   @relation(fields: [refundId], references: [id], onDelete: Cascade)
  saleItemId  String   @map("sale_item_id")
  saleItem    SaleItem @relation(fields: [saleItemId], references: [id])
  quantity    Int
  amount      Decimal  @db.Decimal(10, 2)
  restock     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([refundId])
  @@index([saleItemId])
  @@map("refund_items")
}


model Shift {
  id              String      @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  storeId    String   @map("store_id")
  store      Store @relation(fields: [storeId], references: [id])
  shiftNumber     String      @map("shift_number")
  cashierId       String      @map("cashier_id")
  cashier         User        @relation("CashierShifts", fields: [cashierId], references: [id])
  status          ShiftStatus @default(OPEN)
  openingCash     Decimal     @db.Decimal(10, 2) @map("opening_cash")
  expectedCash    Decimal?    @db.Decimal(10, 2) @map("expected_cash")
  closingCash     Decimal?    @db.Decimal(10, 2) @map("closing_cash")
  cashDifference  Decimal?    @db.Decimal(10, 2) @map("cash_difference")
  notes           String?
  forceCloseReason String?    @map("force_close_reason")
  forceClosedById String?     @map("force_closed_by_id")
  forceClosedBy   User?       @relation("ShiftForceCloser", fields: [forceClosedById], references: [id])
  sales           Sale[]
  openedAt        DateTime    @default(now()) @map("opened_at")
  closedAt        DateTime?   @map("closed_at")

  @@index([cashierId, status])
  @@index([openedAt])
  @@index([businessId])
  @@unique([businessId, shiftNumber])
  @@index([storeId])
  @@map("shifts")
}


model Supplier {
  id          String          @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  name        String
  contactName String?         @map("contact_name")
  phone       String?
  email       String?
  address     String?
  active      Boolean         @default(true)
  purchaseOrders PurchaseOrder[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([name])
  @@index([businessId])
  @@unique([businessId, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  storeId    String   @map("store_id")
  store      Store @relation(fields: [storeId], references: [id])
  poNumber       String              @map("po_number")
  supplierId     String              @map("supplier_id")
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  totalCost      Decimal             @db.Decimal(12, 2) @map("total_cost")
  notes          String?

  createdById    String              @map("created_by_id")
  createdBy      User                @relation("PurchaseOrderCreator", fields: [createdById], references: [id])

  orderedAt      DateTime?           @map("ordered_at")
  orderedById    String?             @map("ordered_by_id")
  orderedBy      User?               @relation("PurchaseOrderOrderer", fields: [orderedById], references: [id])

  receivedAt     DateTime?           @map("received_at")

  cancelledAt    DateTime?           @map("cancelled_at")
  cancelReason   String?             @map("cancel_reason")
  cancelledById  String?             @map("cancelled_by_id")
  cancelledBy    User?               @relation("PurchaseOrderCanceller", fields: [cancelledById], references: [id])

  items          PurchaseOrderItem[]
  movements      InventoryMovement[]

  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@index([businessId])
  @@unique([businessId, poNumber])
  @@index([storeId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String        @map("purchase_order_id")
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String        @map("product_id")
  product          Product       @relation(fields: [productId], references: [id])
  quantityOrdered  Int           @map("quantity_ordered")
  quantityReceived Int           @default(0) @map("quantity_received")
  unitCost         Decimal       @db.Decimal(10, 2) @map("unit_cost")
  lineTotal        Decimal       @db.Decimal(12, 2) @map("line_total")
  createdAt        DateTime      @default(now()) @map("created_at")

  @@unique([purchaseOrderId, productId])
  @@index([productId])
  @@map("purchase_order_items")
}

model InventoryMovement {
  id               String                @id @default(cuid())
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id])
  storeId    String   @map("store_id")
  store      Store @relation(fields: [storeId], references: [id])
  productId        String                @map("product_id")
  product          Product               @relation(fields: [productId], references: [id])
  type             InventoryMovementType
  quantityChange   Int                   @map("quantity_change")
  previousQuantity Int                   @map("previous_quantity")
  newQuantity      Int                   @map("new_quantity")
  saleId           String?               @map("sale_id")
  sale             Sale?                 @relation(fields: [saleId], references: [id])
  refundId         String?               @map("refund_id")
  refund           Refund?               @relation(fields: [refundId], references: [id])
  purchaseOrderId  String?               @map("purchase_order_id")
  purchaseOrder    PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  reason           String?
  createdById      String                @map("created_by")
  createdBy        User                  @relation("MovementCreator", fields: [createdById], references: [id])
  createdAt        DateTime              @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@index([saleId])
  @@index([refundId])
  @@index([purchaseOrderId])
  @@index([businessId])
  @@index([storeId])
  @@map("inventory_movements")
}

model PlatformAdmin {
  id           String             @id @default(cuid())
  name         String
  email        String             @unique
  passwordHash String             @map("password_hash")
  active       Boolean            @default(true)
  lastLoginAt  DateTime?          @map("last_login_at")
  auditLogs    PlatformAuditLog[]
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([active])
  @@map("platform_admins")
}

model PlatformAuditLog {
  id              String        @id @default(cuid())
  platformAdminId String        @map("platform_admin_id")
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)
  action          String
  targetType      String        @map("target_type")
  targetId        String?       @map("target_id")
  targetLabel     String?       @map("target_label")
  details         String?
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([platformAdminId])
  @@index([targetType])
  @@index([targetId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

